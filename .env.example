# ÄGE veebipoe keskkonnamuutujad
# -----------------------------------------------------------------------------
# NETLIFYS: Site configuration → Environment variables → Add a variable.
#           Pärast muutmist tee uus deploy (Deploys → Trigger deploy).
# KOHALIKULT: kopeeri see fail nimega .env ja täida väärtused
#           (.env on .gitignore'is — ära kunagi pane päris võtmeid GitHubi!).
#           Kohalik server (npm run dev) loeb .env faili ise.
#           Ilma ühegi võtmeta saab kõike proovida: npm run dev:mock (vt allpool „Näidisrežiim“).
# Siin failis EI OLE ühtegi päris saladust — ainult näidised ja selgitused.
# -----------------------------------------------------------------------------

# =============================================================================
# MAKSED (Stripe)
# =============================================================================

# Stripe'i SALAJANE võti (kohustuslik maksmiseks).
# Leiad: https://dashboard.stripe.com → Developers → API keys → "Secret key".
#  - sk_test_... = testrežiim (raha ei liigu; testkaart 4242 4242 4242 4242,
#    suvaline tulevane kuupäev ja CVC). Kasuta seda enne päris avamist.
#  - sk_live_... = päris maksed. Pane see Netlifysse alles siis, kui kõik töötab.
# NB! See peab algama "sk_" (mitte "pk_" — see on avalik võti ja siin ei tööta).
# Makseviisid (kaart, Apple Pay, Google Pay, pangalingid) lülitad sisse Stripe'i
# töölaual: Settings → Payment methods. Kviitungid kliendile: Settings → Emails.
STRIPE_SECRET_KEY=sk_test_...

# Stripe'i webhooki allkirja saladus (kohustuslik — ilma selleta ei märgita tellimusi makstuks!).
# Loo: Stripe → Developers → Webhooks → Add endpoint
#   Endpoint URL: https://<sinu-domeen>/api/stripe-webhook
#   Sündmused: checkout.session.completed, checkout.session.async_payment_succeeded,
#              checkout.session.async_payment_failed, checkout.session.expired, charge.refunded
# Seejärel ava loodud endpoint → "Signing secret" → Reveal → kopeeri (algab "whsec_").
# Test- ja live-režiimil on ERINEVAD saladused — vaheta see koos STRIPE_SECRET_KEY-ga.
STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# ANDMEBAAS (tellimused, laoseis, taganemisavaldused)
# =============================================================================

# Netlify DB (Postgres) seab selle muutuja ISE, kui lisad saidile andmebaasi:
# Netlify → Extensions → Neon / Netlify DB → Add database. Käsitsi pole vaja midagi kirjutada.
# Kui andmebaas puudub, ei võta pood tellimusi vastu (kassa ütleb, et vastuvõtt on ajutiselt peatatud).
# NETLIFY_DATABASE_URL=postgres://...

# Muu Postgres (valikuline, kui EI kasuta Netlify DB-d): ühenduse aadress.
# DATABASE_URL=postgres://kasutaja:parool@host/andmebaas?sslmode=require

# Ainult kohalikus arenduses: kaust, kuhu PGlite (Postgres arvutis) andmed salvestab.
# Vaikimisi .data/pglite. Netlifys seda ei kasutata.
# PGLITE_DIR=.data/pglite

# =============================================================================
# E-POST (Resend) — tellimuse kinnitus, omaniku teavitus, taganemisavalduse kinnitus
# =============================================================================

# Resendi API võti (https://resend.com → API Keys → Create API Key, õigus "Sending access").
# Kui puudub, siis kirju ei saadeta, aga tellimused töötavad edasi (logis on hoiatus).
RESEND_API_KEY=re_...

# Saatja aadress. Domeen peab olema Resendis kinnitatud (Resend → Domains → Add Domain,
# lisa DNS-kirjed oma domeeni haldusesse). Kuni domeen pole kinnitatud, võib testida
# aadressiga onboarding@resend.dev (saadab ainult sinu enda Resendi konto e-postile).
MAIL_FROM=ÄGE <tellimused@sinudomeen.ee>

# Omaniku e-post: siia tulevad teavitused uue makstud tellimuse ja taganemisavalduse kohta.
# Kui puudub, teavitusi ei saadeta (kõik on siiski halduspaneelis näha).
ADMIN_EMAIL=aarmiselt@gmail.com

# =============================================================================
# HALDUSPANEEL (/admin)
# =============================================================================

# Omaniku parooli räsi (mitte parool ise!). Loo käsuga:  npm run admin:hash
# (käsk prindib nii ADMIN_PASSWORD_HASH-i kui ka sobiva ADMIN_SESSION_SECRET-i).
# Vorming: scrypt$N$r$p$saltBase64$hashBase64
# Kohalikus .env failis pane räsi ÜHEKORDSETESSE jutumärkidesse ('…'), sest selles on $-märgid.
# Netlifys lisa see Environment variables alla ja märgi „Secret“.
ADMIN_PASSWORD_HASH=

# Seansiküpsise allkirjastamise saladus, vähemalt 32 juhuslikku märki (vt npm run admin:hash).
# Selle või parooli muutmine logib kõik seadmed halduspaneelist välja.
ADMIN_SESSION_SECRET=

# Ainult kohalikuks arenduseks (npm run dev:mock seab ise "demo-admin"). Netlifysse EI lisa!
# ADMIN_DEV_PASSWORD=

# =============================================================================
# TARNE (pakiautomaadid)
# =============================================================================

# Vedajad, kuhu saab päriselt tellida (komadega). Vaikimisi: omniva,smartpost
# Võimalikud: omniva, smartpost, dpd. Lisa "dpd" alles siis, kui sul on DPD-ga leping ja
# saad DPD pakke saata. Server keeldub tellimusest vedajaga, mida siin pole.
ENABLED_CARRIERS=omniva,smartpost

# DPD pakiautomaatide nimekirja JSON-aadress (valikuline).
# DPD-l pole avalikku võtmeta nimekirja (DPD API vajab kliendilepingut ja kasutajatunnuseid).
# Kui saad DPD-lt (või teenusepakkujalt) JSON-faili aadressi, kus on automaatide id, nimi,
# linn ja aadress, pane see siia. Kui jätad tühjaks, saab klient DPD automaadi kassas
# käsitsi sisestada.
DPD_LOCKERS_URL=

# =============================================================================
# SAIT
# =============================================================================

# Saidi avalik aadress e-kirjade linkide jaoks (valikuline). Netlify teab seda ise (URL),
# seega sea see ainult siis, kui kirjades peab olema muu aadress (nt https://www.age.ee).
# SITE_URL=https://www.sinudomeen.ee

# =============================================================================
# NÄIDISREŽIIM (ainult kohalik arendus — Netlifys need EI toimi ka siis, kui lisad)
# =============================================================================
# npm run dev:mock seab need ise. Andmebaas on ka näidisrežiimis päris (PGlite).
#
# MOCK_STRIPE=1  → makse käib kohaliku test-Stripe'i lehe kaudu (/__mock-stripe/…,
#                  „TESTMAKSE — päris raha ei liigu“); webhook saadetakse päriselt allkirjastatuna.
# MOCK_MAIL=1    → e-kirjad salvestatakse failidena kausta .data/mail (MAIL_DIR muudab kausta).
# MOCK_LOCKERS=1 → pakiautomaadid tulevad NÄIDISNIMEKIRJAST (tests/fixtures/mock-lockers-*.json).
# MOCK_STRIPE_DELAY_MS=12000 → „viivitusega makse“ kinnitub test-Stripe'is nii mitme ms pärast.
# MAIL_DIR=.data/mail
